# inkan environment
#
# Copy to .env and fill in. Never commit .env.
#
# The runner must NOT receive any PAYPAL_* variable. Its environment is
# validated at startup and throws if one is present. See docs/architecture.md §8.

# --- service only ---------------------------------------------------------

# Postgres on Neon. Drizzle with the neon-http driver.
DATABASE_URL=

PAYPAL_ENVIRONMENT=sandbox

# Read by exactly one module: src/lib/server/paypal/client.ts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# --- service and runner ---------------------------------------------------

# The runner's only address for the service.
MANDATE_BASE_URL=http://localhost:5173

MODEL_API_KEY=
MODEL_NAME=

# --- service, defaults live in code ---------------------------------------

CAPABILITY_TTL_SECONDS=120

# Leave blank to use the value asserted by the policy tests.
# PURPOSE_FLOOR=
# AUTO_APPROVE_PURPOSE_SCORE=
