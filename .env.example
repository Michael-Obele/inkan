# inkan environment
#
# Copy to .env and fill in. Never commit .env.
#
# The runner process must never receive a PAYPAL_* variable. Its environment is
# validated at startup and throws if one is present. That absence is the security
# claim in one line, so never pass this file to the runner.

# --- service only ---------------------------------------------------------

# Postgres on Neon. Optional: leave it blank and the ledger lives in the process,
# which is enough to run the whole demo. Set it only for a durable copy.
DATABASE_URL=

PAYPAL_ENVIRONMENT=sandbox

# Read by exactly one module: src/lib/server/paypal/client.ts
#
# The client id is filled in because it is a sandbox id and it is not the half that
# authorises anything. The secret is blank on purpose: PayPal's own getting-started
# guide says never to commit it, and the people judging this wrote that guide. Get
# it from Developer Dashboard, Apps & Credentials, Sandbox, and paste it here.
PAYPAL_CLIENT_ID=sandbox-client-id-goes-here
PAYPAL_CLIENT_SECRET=

# Used to verify webhook signatures. Optional until webhooks are wired.
PAYPAL_WEBHOOK_ID=

# --- the demo store -------------------------------------------------------

# The handle the agent asks for. It is all the agent is told.
STORE_SLUG=demo-store

# The PayPal merchant behind that handle. This is what the allowance checks. It is
# an identifier, not a credential, and the recording already names it.
STORE_MERCHANT_ID=8NJ2CK2C6DN3S

# Sandbox card used by the demo. Test values only, they move no real money. This is
# PayPal's own published test card, so it is safe to read here.
#
# It stands in for a vaulted payment method: the token a person would earn by
# approving a vault setup in a browser. Only the token is missing, not the flow
# around it. See "How a person would link a payment method" in the README.
TEST_CARD_NAME=Inkan Demo
TEST_CARD_NUMBER=4012000033330026
TEST_CARD_EXPIRY=2027-01
TEST_CARD_CVV=123

# --- service and runner ---------------------------------------------------

# The runner's only address for the service.
MANDATE_BASE_URL=http://localhost:5173

# --- service, defaults live in code ---------------------------------------

CAPABILITY_TTL_SECONDS=120

# live, or replay.
#
# Leave this blank and the app decides from what it can actually do: live when the
# three PayPal values above are set, replay when they are not. A database is not
# part of that decision, because the ledger can live in the process.
DEMO_MODE=

# --- receipt text only, optional ------------------------------------------

# Without a key the receipt is written from a template, and the receipt records
# "template" as its author rather than pretending a model wrote it. Apply for a
# key at https://platform.deepseek.com/api_keys
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
