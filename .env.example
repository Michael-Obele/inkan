# inkan environment
#
# Copy to .env and fill in. Never commit .env.
#
# The runner process must never receive a PAYPAL_* variable. Its environment is
# validated at startup and throws if one is present. That absence is the security
# claim in one line, so never pass this file to the runner.

# --- service only ---------------------------------------------------------

# Postgres on Neon. Drizzle with the neon-http driver.
DATABASE_URL=

PAYPAL_ENVIRONMENT=sandbox

# Read by exactly one module: src/lib/server/paypal/client.ts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Used to verify webhook signatures. Optional until webhooks are wired.
PAYPAL_WEBHOOK_ID=

# --- the demo store -------------------------------------------------------

# The handle the agent asks for. It is all the agent is told.
STORE_SLUG=demo-store

# The PayPal merchant behind that handle. This is what the allowance checks.
STORE_MERCHANT_ID=

# Sandbox card used by the demo. Test values only, they move no real money.
TEST_CARD_NAME=Inkan Demo
TEST_CARD_NUMBER=4012000033330026
TEST_CARD_EXPIRY=2027-01
TEST_CARD_CVV=123

# --- service and runner ---------------------------------------------------

# The runner's only address for the service.
MANDATE_BASE_URL=http://localhost:5173

# --- service, defaults live in code ---------------------------------------

CAPABILITY_TTL_SECONDS=120

# live, or replay. Replay needs no keys, no network and no database: it plays back
# one recorded sandbox run, and the screen says so.
DEMO_MODE=live

# --- receipt text only, optional ------------------------------------------

# Without a key the receipt is written from a template, and the receipt records
# "template" as its author rather than pretending a model wrote it. Apply for a
# key at https://platform.deepseek.com/api_keys
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
