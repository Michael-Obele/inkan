{
	"name": "inkan",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"adversarial": "bun --env-file=.env tools/adversarial.ts",
		"record:tape": "bun --env-file=.env tools/record-tape.ts",
		"runner": "bun --env-file=.env runner/src/index.ts"
	},
	"devDependencies": {
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.70.0",
		"@neondatabase/serverless": "^1.1.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0",
		"sv-agentation": "^0.4.0",
		"valibot": "^1.5.0"
	}
}
