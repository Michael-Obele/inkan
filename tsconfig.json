{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		// Mirrors package.json `imports`; TypeScript needs paths to resolve the
		// extensionless `#lib/...` specifiers that Vite resolves natively.
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts", "prettier.config.js", "drizzle.config.ts"]
}
