# The runner's environment, and only what it needs.
#
# It must never see a PAYPAL_* variable, because that absence is the product
# claim. Bun loads the repository .env automatically, and that file holds the
# PayPal secrets, so pass this file explicitly instead:
#
#   bun --env-file=runner/.env.example runner/src/index.ts
#
# An explicit --env-file replaces the automatic .env, which is why this works
# and `bun runner/src/index.ts` does not.

MANDATE_BASE_URL=http://localhost:5173

# Who the allowance is issued to. The seeded demo uses this name.
AGENT_ID=coffee-runner

# Optional. Without a key the runner reads the prose with a local parser and the
# receipt uses a template, so both still work offline.
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
